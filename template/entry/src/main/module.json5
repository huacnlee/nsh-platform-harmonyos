{
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "requestPermissions": {{requestPermissions}},
    "pages": "$profile:main_pages",
    "abilities": {{abilities}}{{moduleExtras}}
  }
}
